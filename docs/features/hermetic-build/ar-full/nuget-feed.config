<?xml version="1.0" encoding="utf-8"?>
<!-- Probe: one flat config for the whole meta tree (no hierarchy merge). Token comes from the env var, never stored here. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="ar-dev" value="https://pkgs.dev.azure.com/dt4dev/AR/_packaging/ar-dev/nuget/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceCredentials>
    <ar-dev>
      <add key="Username" value="ar" />
      <add key="ClearTextPassword" value="%AA_AR_TOKEN%" />
    </ar-dev>
  </packageSourceCredentials>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="ar-dev">
      <package pattern="Babel.*" />
      <package pattern="Editor*" />
      <package pattern="semverchecker*" />
      <package pattern="MESCIUS.ActiveReports*" />
      <package pattern="GCCN.ActiveReports*" />
      <package pattern="MESCIUS.DataVisualization.*" />
      <package pattern="GrapeCity.DataVisualization.*" />
      <package pattern="GCCN.DataVisualization.*" />
      <package pattern="MESCIUS.Data.*" />
      <package pattern="Gccn.Data.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
