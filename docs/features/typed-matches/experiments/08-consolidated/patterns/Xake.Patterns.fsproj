<Project Sdk="Microsoft.NET.Sdk">
  <!-- Experiment 08: would be src/patterns/Xake.Patterns.fsproj. The runtime half of the typed
       patterns (brief decision 17): what the erased provided members call, the form-B builder, and
       the TypeProviderAssembly attribute naming the design-time dll. Same TFMs as the engine.
       Nothing in the repo compiles against this dll except the design-time project: any
       compilation that references it needs the design-time dll (FS3031), see ../README section 08. -->
  <PropertyGroup>
    <AssemblyName>Xake.Patterns.Exp08</AssemblyName>
    <!-- Not 1.0.0.0: experiments 03, 04, 09 build different dlls with that very identity, and an IDE
         language server keeps the first one it loads (FS3033 "Could not load type PatternBuilders"). -->
    <Version>0.8.0</Version>
    <AssemblyVersion>0.8.0.0</AssemblyVersion>
    <FileVersion>0.8.0.0</FileVersion>
    <TargetFrameworks>net462;netstandard2.0</TargetFrameworks>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Runtime.fs" />
    <Compile Include="AssemblyInfo.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="8.0.100" />
    <ProjectReference Include="../engine/src/core/Xake.fsproj" PrivateAssets="all" />
  </ItemGroup>
  <!-- In-repo convenience: `dotnet build patterns -c Release` also builds ../designtime, which copies
       its output to bin/typeproviders/fsharp41/netstandard2.0/ (where the compiler and FsAutoComplete
       look for the design-time dll of a directly #r'd Xake.Patterns.dll). InDesignTimeBuild stops
       the recursion (designtime references this project; global properties flow to it). Not part
       of the shipped design: in src/ the package layout does this. -->
  <Target Name="BuildDesignTime" AfterTargets="Build" Condition="'$(TargetFramework)' == 'netstandard2.0' And '$(InDesignTimeBuild)' != 'true'">
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)../designtime/Xake.Patterns.DesignTime.fsproj&quot; -c $(Configuration) -p:InDesignTimeBuild=true -nologo -v:q" />
  </Target>
</Project>
