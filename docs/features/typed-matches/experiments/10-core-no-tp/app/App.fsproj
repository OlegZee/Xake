<Project Sdk="Microsoft.NET.Sdk">
  <!-- Experiment 10: the consumer compiled (net8.0, Release) against the engine's Xake.dll only. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../consumer/Rules.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="8.0.100" />
    <Reference Include="Xake" HintPath="../engine/src/core/bin/Release/netstandard2.0/Xake.dll" />
  </ItemGroup>
</Project>
