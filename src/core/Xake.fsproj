<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Xake</AssemblyName>
    <OutputType>Library</OutputType>
    <!-- The SDK would otherwise reference its own FSharp.Core, see the pin below. -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Packed together with Xake.Dotnet into a single "Xake" package, see src/dotnet.
         The id below is never published; it only has to differ from that package's id,
         otherwise restore fails with "Ambiguous project name 'Xake'". -->
    <IsPackable>false</IsPackable>
    <PackageId>Xake.Engine</PackageId>
    <TargetFrameworks>net462;netstandard2.0</TargetFrameworks>
    <Copyright>(c) OlegZee 2014-2026</Copyright>

    <PackageProjectUrl>https://github.com/xakebuild/Xake</PackageProjectUrl>
    <PackageIconUrl>https://github.com/xakebuild/Xake/raw/dev/Icon.png</PackageIconUrl>
    <Description>Xake build tool, the engine</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Prelude.fs" />
    <Compile Include="Logging.fs" />
    <Compile Include="Pickler.fs" />
    <Compile Include="Env.fs" />
    <Compile Include="Path.fs" />
    <Compile Include="PathExt.fs" />
    <Compile Include="File.fsi" />
    <Compile Include="File.fs" />
    <Compile Include="Fileset.fs" />
    <Compile Include="Types.fs" />
    <Compile Include="CommonLib.fs" />
    <Compile Include="Database.fs" />
    <Compile Include="RecipeBuilder.fs" />
    <Compile Include="RecipeFunctions.fs" />
    <Compile Include="WorkerPool.fs" />
    <Compile Include="Resource.fs" />
    <Compile Include="Progress.fs" />
    <Compile Include="ExecTypes.fs" />
    <Compile Include="XakeScript.fs" />
    <Compile Include="DependencyAnalysis.fs" />
    <Compile Include="ExecCore.fs" />
    <Compile Include="ScriptRunner.fs" />
    <Compile Include="XakeScriptBuilder.fs" />
    <Compile Include="RuleBuilder.fs" />
    <Compile Include="ScriptFuncs.fs" />
    <Compile Include="Vars.fs" />
    <Compile Include="ProcessExec.fs" />
    <Compile Include="FileTasksImpl.fs" />
    <Compile Include="Tasks\Cp.fs" />
    <Compile Include="Tasks\Rm.fs" />
    <Compile Include="Tasks\Shell.fs" />
    <Compile Include="Tasks\misc.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Pinned deliberately: the version referenced here becomes the FSharp.Core floor for
         every consumer of the package. Left unpinned it silently follows the SDK used to
         build, so bumping the SDK would force everyone onto a newer FSharp.Core. 8.0.100 is
         the .NET 8 baseline; raise it only as a conscious, breaking-ish decision. -->
    <PackageReference Include="FSharp.Core" Version="8.0.100" />
  </ItemGroup>

  <ItemGroup>
    <!-- Xake.Dotnet ships in the same package and reuses the engine's low-level plumbing
         (ProcessExec, CommonLib) rather than carrying its own copies. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Xake.Dotnet</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
