<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Xake.Dotnet</AssemblyName>

    <!-- The whole tool ships as a single package: this project references the core and
         pulls its assembly into the same nupkg (see IncludeCoreOutput below), so both
         assemblies share one version and one publish. -->
    <PackageId>Xake</PackageId>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeCoreOutput</TargetsForTfmSpecificBuildOutput>
    <OutputType>Library</OutputType>
    <!-- The SDK would otherwise reference its own FSharp.Core, see the pin below. -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TargetFrameworks>net462;netstandard2.0</TargetFrameworks>
    <Copyright>(c) OlegZee 2014-2026</Copyright>
    <Authors>OlegZee</Authors>

    <Description>Xake build tool: the engine and the tasks for full .NET framework</Description>
    <PackageProjectUrl>https://github.com/xakebuild/Xake</PackageProjectUrl>
    <RepositoryUrl>https://github.com/xakebuild/Xake</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>fsharp;build;make;buildtool;automation;shake</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- nuget.org renders these; they are packed, not referenced by path, so the files have to
       be listed explicitly. -->
  <ItemGroup>
    <None Include="..\..\Icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\readme.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="DotNetFwk.fs" />
    <Compile Include="ResourceFileset.fs" />

    <Compile Include="DotnetTasks.fs" />
    <Compile Include="Dotnet.csc.fs" />
    <Compile Include="Dotnet.fsc.fs" />
    <Compile Include="Dotnet.resgen.fs" />
    <Compile Include="Dotnet.Msbuild.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\Xake.fsproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Xake.dll and Xake.xml next to Xake.Dotnet.dll in lib/{tfm} -->
  <Target Name="IncludeCoreOutput">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget','ProjectReference'))" />
    </ItemGroup>
  </Target>

  <!-- ResXResourceReader, needed to compile .resx, lives in System.Windows.Forms and is not
       one of the SDK's implicit references for net462. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

  <!-- Kept in step with src/core: this is the FSharp.Core floor the package imposes on its
       consumers. See the note there. -->
  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="8.0.100" />
  </ItemGroup>
</Project>
