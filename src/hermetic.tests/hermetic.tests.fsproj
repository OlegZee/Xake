<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The shared helpers are linked from src/tests, not copied. XakeTestBase's scratch
         folders therefore stay under src/tests/~testout~ (its __SOURCE_DIRECTORY__). -->
    <Compile Include="..\tests\Common.fs" Link="Common.fs" />
    <Compile Include="..\tests\XakeTestBase.fs" Link="XakeTestBase.fs" />
    <Compile Include="ProjectImportTests.fs" />
    <Compile Include="LockDiffTests.fs" />
    <Compile Include="FromLockTests.fs" />
    <Compile Include="CscLockTests.fs" />
    <Compile Include="FscLockTests.fs" />
    <Compile Include="NugetTests.fs" />
    <Compile Include="RestoreTests.fs" />
    <Compile Include="SbomTests.fs" />
    <Compile Include="VerifyTests.fs" />
    <Compile Include="StrongNameTests.fs" />
    <Compile Include="PackTests.fs" />
    <Compile Include="SignTests.fs" />
    <Compile Include="ToolsetImportTests.fs" />
    <Compile Include="ResxImportTests.fs" />
    <Compile Include="FsprojImportTests.fs" />
    <Compile Include="HermeticLockTests.fs" />
    <Compile Include="DescriptionTests.fs" />
    <Compile Include="DescribedTests.fs" />
    <Compile Include="DescriptionImportTests.fs" />
    <Compile Include="LockRule.fs" />
    <Compile Include="LocksTests.fs" />
    <Compile Include="BuildFromLockTests.fs" />
    <Compile Include="ImportFidelityTests.fs" />
    <Compile Include="LineEndTests.fs" />
    <Compile Include="RecordTests.fs" />
    <Compile Include="ImportDiagnosticsTests.fs" />
    <Compile Include="SdkFreeImportTests.fs" />
    <Compile Include="AppTests.fs" />
    <Compile Include="RunFolderTests.fs" />
    <Compile Include="HermeticVarsTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The in-repo Xake (engine and Xake.Dotnet), as src/hermetic builds on it until 4.0. -->
    <ProjectReference Include="..\core\Xake.fsproj" />
    <ProjectReference Include="..\dotnet\Xake.Dotnet.fsproj" />
    <ProjectReference Include="..\hermetic\Xake.Hermetic.Dotnet.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.0" />
    <PackageReference Include="NUnit" Version="3.13.3" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.2.1" />
    <PackageReference Include="NUnit.Analyzers" Version="3.6.1" />
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
  </ItemGroup>
</Project>
