<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Xake.Hermetic.Dotnet</AssemblyName>
    <RootNamespace>Xake.Hermetic.Dotnet</RootNamespace>

    <!-- Versioned independently of Xake (extraction-plan.md §4): 0.x is a preview and may
         break. Same mechanism as src/dotnet: the build script and CI override it with
         /p:Version=...; this is the value a plain `dotnet pack` produces. -->
    <PackageId>Xake.Hermetic.Dotnet</PackageId>
    <Version>0.5.2</Version>
    <OutputType>Library</OutputType>
    <!-- The SDK would otherwise reference its own FSharp.Core, see the pin below. -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TargetFrameworks>net462;netstandard2.0</TargetFrameworks>
    <Copyright>(c) OlegZee 2014-2026</Copyright>
    <Authors>OlegZee</Authors>

    <Description>Reproducible .NET builds for Xake: lock files, restore, SBOM, verification, packing and signing</Description>
    <PackageProjectUrl>https://github.com/OlegZee/Xake</PackageProjectUrl>
    <RepositoryUrl>https://github.com/OlegZee/Xake</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>reproducible;lockfile;sbom;cyclonedx;hermetic;dotnet</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- nuget.org renders these; they are packed, not referenced by path, so the files have to
       be listed explicitly. `readme.md` is the git-tracked casing (docs/session.md). -->
  <ItemGroup>
    <None Include="..\..\Icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Order follows the dependencies: the json reader of tool output and the root tokens
       first (the project description is the core's, `Xake.Dotnet.Description`), then
       Nuget (assets, nuspec, cache) and Restore (which names no lock type), Git (revision
       token), the lock format and the lock's side of a build (Lock.build/compile/record/verify),
       a description as a compilation and the builder operations (Described.fs: config,
       packages, lock and nofetch on top of the core's `project`), the import (csproj and fsproj), and the release
       pipeline. Signing is the one delegated rule (signing.md); it uses Verify, StrongName
       and Pack, so it compiles after all three. -->
  <ItemGroup>
    <Compile Include="ToolJson.fs" />
    <Compile Include="Roots.fs" />
    <Compile Include="Nuget.fs" />
    <Compile Include="Restore.fs" />
    <Compile Include="Git.fs" />
    <Compile Include="Lock.fs" />
    <Compile Include="Described.fs" />
    <Compile Include="Apps.fs" />
    <Compile Include="RunFolder.fs" />
    <Compile Include="Locks.fs" />
    <Compile Include="Project.fs" />
    <Compile Include="Import.fs" />
    <Compile Include="Sbom.fs" />
    <Compile Include="Verify.fs" />
    <Compile Include="StrongName.fs" />
    <Compile Include="Pack.fs" />
    <Compile Include="Sign.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built on the published package, not on src/dotnet and src/core: the `Xake` package
         carries both Xake.dll and Xake.Dotnet.dll, and the range is what the nuspec
         dependency says. 3.9.0 is the release this package builds on: it owns the project
         description (`Xake.Dotnet.Description`, `ProjectPlan`) and the `Project` field of
         `CscSettingsType`/`FscSettingsType` (3.8.0 brought `ArtifactDep2`, the run folder rule
         relies on it, and `ResxFormat`). nuget.org carries 3.9.0 as 3.9.0.30 (publish.yml
         appends the run number); the lower bound is that exact published version, or NuGet
         warns NU1603 on every restore.

         The upper bound is the next major (the owner's decision for 0.4). The price: F#
         records are not binary-compatible across releases that add a field (a copy-and-update
         expression compiles to the full constructor), so a 3.x minor that adds a field to a
         record this package builds (`CscSettingsType`, `FscSettingsType`, `Csc`, `Fsc`, the
         run options) needs a release of this package with it. -->
    <PackageReference Include="Xake" Version="[3.10.0.35, 3.11)" />
  </ItemGroup>

  <!-- Test assemblies only; no other package sees these internals. hermetic.tests tests the
       parsers (Json, Project.parseImport, Nuget.frameworkFullName, the PE Layout). -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>hermetic.tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- ZipArchive (Sbom.fs, Sign.fs): on net462 the SDK adds it as a netstandard facade, which
       the project description (xake.project.json, imported from this file) does not see; named
       here so the import carries it into a description-driven fsc build. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <!-- Kept in step with src/core and src/dotnet: the FSharp.Core floor consumers inherit. -->
  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="8.0.100" />
  </ItemGroup>
</Project>
